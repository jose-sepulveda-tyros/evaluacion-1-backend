# Colección de pruebas del equipo.
# Amplía la colección inicial del rol 4 (rama feature/prueba-calidad, e1c7ed7).
# Ejecutar EN ORDEN sobre una instancia recién iniciada y vacía.
# Reiniciar Uvicorn antes de repetir: los datos e IDs viven en memoria.
# Uso manual: extensión REST Client de VS Code, opción Send Request.
# Uso automático: python tests_manual/verificar_coleccion.py
# Las líneas "# expect" documentan el resultado y las comprueba el verificador.
# No ejecutar contra una instancia con datos que se quieran conservar.
@baseUrl = http://127.0.0.1:8000

### 01. Estudiantes inicialmente vacíos
# expect {"status": 200, "body": {"$": []}}
GET {{baseUrl}}/estudiantes

### 02. Salas inicialmente vacías
# expect {"status": 200, "body": {"$": []}}
GET {{baseUrl}}/salas

### 03. Reservas inicialmente vacías
# expect {"status": 200, "body": {"items": [], "total": 0, "pagina": 1, "limite": 10, "total_paginas": 0}}
GET {{baseUrl}}/reservas

### 04. Incidencias inicialmente vacías
# expect {"status": 200, "body": {"$": []}}
GET {{baseUrl}}/incidencias

### 05. Crear estudiante
# expect {"status": 201, "body": {"id": 1, "correo": "juan@example.com"}, "headers": {"Location": "/estudiantes/1"}}
POST {{baseUrl}}/estudiantes
Content-Type: application/json

{
  "nombre": "Juan Pérez",
  "carrera": "Psicología",
  "correo": "juan@example.com",
  "activo": true
}

### 06. Crear segundo estudiante
# expect {"status": 201, "body": {"id": 2}}
POST {{baseUrl}}/estudiantes
Content-Type: application/json

{
  "nombre": "Ana Soto",
  "carrera": "Psicología",
  "correo": "ana@example.com",
  "activo": true
}

### 07. Consultar estudiante
# expect {"status": 200, "body": {"nombre": "Juan Pérez"}}
GET {{baseUrl}}/estudiantes/1

### 08. Listar estudiantes
# expect {"status": 200, "body": {"0.id": 1, "1.id": 2}}
GET {{baseUrl}}/estudiantes

### 09. Crear sala con equipamiento como lista
# expect {"status": 201, "body": {"id": 1, "capacidad": 6}, "headers": {"Location": "/salas/1"}}
POST {{baseUrl}}/salas
Content-Type: application/json

{
  "nombre": "Sala A1",
  "capacidad": 6,
  "ubicacion": "Biblioteca Piso 2",
  "equipamiento": [
    "Pizarra"
  ]
}

### 10. Crear segunda sala
# expect {"status": 201, "body": {"id": 2}}
POST {{baseUrl}}/salas
Content-Type: application/json

{
  "nombre": "Sala A2",
  "capacidad": 2,
  "ubicacion": "Biblioteca Piso 2",
  "equipamiento": [
    "Pizarra"
  ]
}

### 11. Consultar sala
# expect {"status": 200, "body": {"equipamiento": ["Pizarra"]}}
GET {{baseUrl}}/salas/1

### 12. Listar salas
# expect {"status": 200, "body": {"0.id": 1, "1.id": 2}}
GET {{baseUrl}}/salas

### 13. Actualizar sala sin reservas
# expect {"status": 200, "body": {"id": 2, "capacidad": 3}}
PUT {{baseUrl}}/salas/2
Content-Type: application/json

{
  "nombre": "Sala A2",
  "capacidad": 3,
  "ubicacion": "Biblioteca Piso 2",
  "equipamiento": [
    "Pizarra"
  ]
}

### 14. Crear reserva válida
# expect {"status": 201, "body": {"id": 1, "cantidad_personas": 4}, "headers": {"Location": "/reservas/1"}}
POST {{baseUrl}}/reservas
Content-Type: application/json

{
  "sala_id": 1,
  "estudiante_id": 1,
  "fecha": "2026-09-20",
  "hora_inicio": "10:00",
  "hora_fin": "12:00",
  "cantidad_personas": 4,
  "estado": "activa"
}

### 15. Crear segunda reserva contigua
# expect {"status": 201, "body": {"id": 2}}
POST {{baseUrl}}/reservas
Content-Type: application/json

{
  "sala_id": 1,
  "estudiante_id": 1,
  "fecha": "2026-09-20",
  "hora_inicio": "12:00",
  "hora_fin": "13:00",
  "cantidad_personas": 4,
  "estado": "activa"
}

