  "sala_id": 1,
  "estudiante_id": 2,
  "fecha": "2026-09-20",
  "hora_inicio": "09:00",
  "hora_fin": "10:00",
  "cantidad_personas": 4,
  "estado": "activa"
}

### 17. Consultar reserva
# expect {"status": 200, "body": {"id": 1, "sala_id": 1, "estudiante_id": 1}}
GET {{baseUrl}}/reservas/1

