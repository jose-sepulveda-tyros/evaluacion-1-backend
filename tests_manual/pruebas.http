### 59. Eliminar reserva sin cuerpo
# expect {"status": 204}
DELETE {{baseUrl}}/reservas/5

### 60. Consultar reserva eliminada
# expect {"status": 404, "body": {"error.code": "RESOURCE_NOT_FOUND"}}
GET {{baseUrl}}/reservas/5

### 61. Eliminar nuevamente
# expect {"status": 404, "body": {"error.code": "RESOURCE_NOT_FOUND"}}
DELETE {{baseUrl}}/reservas/5

### 62. Reactivar después de eliminar
# expect {"status": 200, "body": {"estado": "activa"}}
PUT {{baseUrl}}/reservas/2
Content-Type: application/json

{
  "sala_id": 1,
  "estudiante_id": 1,
  "fecha": "2026-09-20",
  "hora_inicio": "12:00",
  "hora_fin": "13:00",
  "cantidad_personas": 4,
  "estado": "activa"
}

### 63. Estado final de la colección
# expect {"status": 200, "body": {"total": 4, "items.0.id": 1, "items.3.id": 4}}
GET {{baseUrl}}/reservas
